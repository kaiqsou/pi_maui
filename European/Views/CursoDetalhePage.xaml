<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             x:Class="European.Views.CursoDetalhePage"
             x:DataType="vm:CursoDetalheViewModel"
             x:Name="Pagina"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Style="{StaticResource BackTile}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Conteúdo do curso" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandPrimary}" HeightRequest="24" />

            <!-- Resumo do curso -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Style="{StaticResource Pill}" HorizontalOptions="Start">
                            <Label Text="{Binding Curso.Categoria}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource BrandPrimary}" />
                        </Border>
                        <Button Grid.Column="1" Text="&#xe3c9;" Style="{StaticResource IconButton}"
                                Command="{Binding EditarCursoCommand}" IsVisible="{Binding PodeEditarEstrutura}" />
                    </Grid>
                    <Label Text="{Binding Curso.Nome}" Style="{StaticResource TitleMd}" />
                    <Label Text="{Binding Curso.Descricao}" Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xe8b5;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Grid.Column="1" Text="{Binding CargaHorariaFormatada}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xe8ef;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Grid.Column="1" Text="{Binding ResumoTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xe7fb;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Grid.Column="1" Text="{Binding ProfessoresTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent"
                    IsVisible="{Binding PodeCriarProvas}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="&#xe88e;" Style="{StaticResource IconPrimary}" VerticalOptions="Start" />
                    <Label Grid.Column="1" Style="{StaticResource BodySm}" TextColor="{StaticResource OnSurface}"
                           Text="Use o + de cada matéria para adicionar aulas e o botão Nova prova para criar avaliações." />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Módulos" Style="{StaticResource SectionTitle}" />
                <Button Grid.Column="1" Text="Novo módulo" Style="{StaticResource SoftButton}"
                        Command="{Binding NovoModuloCommand}" IsVisible="{Binding PodeEditarEstrutura}" />
            </Grid>

            <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding ModulosPagina}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuloNode">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Modulo.Titulo}" Style="{StaticResource TitleSm}" />
                                        <Label Text="{Binding Modulo.Descricao}" Style="{StaticResource BodySm}"
                                               IsVisible="{Binding Modulo.Descricao, Converter={StaticResource NullToBool}}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="&#xe3c9;" Style="{StaticResource IconButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=EditarModuloCommand, x:DataType=vm:CursoDetalheViewModel}"
                                            CommandParameter="{Binding Modulo}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarEstrutura, x:DataType=vm:CursoDetalheViewModel}" />
                                    <Button Grid.Column="2" Text="&#xe872;" Style="{StaticResource IconButton}" TextColor="{StaticResource Danger}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=ExcluirModuloCommand, x:DataType=vm:CursoDetalheViewModel}"
                                            CommandParameter="{Binding Modulo}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarEstrutura, x:DataType=vm:CursoDetalheViewModel}" />
                                    <Button Grid.Column="3" Text="&#xe145;" Style="{StaticResource IconButton}" TextColor="{StaticResource BrandPrimary}"
                                            ToolTipProperties.Text="Nova matéria"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=NovaMateriaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                            CommandParameter="{Binding Modulo}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarEstrutura, x:DataType=vm:CursoDetalheViewModel}" />
                                </Grid>

                                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Materias}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MateriaNode">
                                            <Border Style="{StaticResource Painel}">
                                                <VerticalStackLayout Spacing="10">

                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding Materia.Nome}" Style="{StaticResource TitleSm}" FontSize="15" />
                                                            <Label Text="{Binding Resumo}" Style="{StaticResource BodySm}" />
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="1" Text="&#xe3c9;" Style="{StaticResource IconButton}" FontSize="16"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=EditarMateriaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                CommandParameter="{Binding Materia}"
                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarEstrutura, x:DataType=vm:CursoDetalheViewModel}" />
                                                        <Button Grid.Column="2" Text="&#xe872;" Style="{StaticResource IconButton}" FontSize="16" TextColor="{StaticResource Danger}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=ExcluirMateriaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                CommandParameter="{Binding Materia}"
                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarEstrutura, x:DataType=vm:CursoDetalheViewModel}" />
                                                        <Button Grid.Column="3" Text="&#xe145;" Style="{StaticResource IconButton}" FontSize="16" TextColor="{StaticResource BrandPrimary}"
                                                                ToolTipProperties.Text="Nova aula"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=NovaAulaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                CommandParameter="{Binding Materia}"
                                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarAulas, x:DataType=vm:CursoDetalheViewModel}" />
                                                    </Grid>

                                                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Aulas}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Aula">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                                                    <Label Text="&#xe1c4;" Style="{StaticResource IconPrimary}" FontSize="16" VerticalOptions="Center" />
                                                                    <Label Grid.Column="1" Text="{Binding Titulo}" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                                                                    <Label Grid.Column="2" Text="{Binding DuracaoTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                                                                    <Button Grid.Column="3" Text="&#xe3c9;" Style="{StaticResource IconButton}" FontSize="16" WidthRequest="30" HeightRequest="30"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=EditarAulaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                            CommandParameter="{Binding .}"
                                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarAulas, x:DataType=vm:CursoDetalheViewModel}" />
                                                                    <Button Grid.Column="4" Text="&#xe872;" Style="{StaticResource IconButton}" FontSize="16" WidthRequest="30" HeightRequest="30"
                                                                            TextColor="{StaticResource Danger}"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=ExcluirAulaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                            CommandParameter="{Binding .}"
                                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeEditarAulas, x:DataType=vm:CursoDetalheViewModel}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Provas}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProvaNode">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                    <Label Text="&#xe862;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                                                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                                        <Label Text="{Binding Titulo}" Style="{StaticResource BodyMd}" />
                                                                        <Label Text="{Binding Resumo}" Style="{StaticResource BodySm}" />
                                                                    </VerticalStackLayout>
                                                                    <Button Grid.Column="2" Text="&#xe3c9;" Style="{StaticResource IconButton}" FontSize="16" WidthRequest="30" HeightRequest="30"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=EditarProvaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                                            CommandParameter="{Binding .}" IsVisible="{Binding PodeEditar}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                    <Button Text="Nova prova" Style="{StaticResource SoftButton}" HorizontalOptions="Start"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=NovaProvaCommand, x:DataType=vm:CursoDetalheViewModel}"
                                                            CommandParameter="{Binding Materia}"
                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CursoDetalheViewModel}}, Path=PodeCriarProvas, x:DataType=vm:CursoDetalheViewModel}" />

                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding TemPaginacao}">
                <Button Grid.Column="0" Text="Anterior" Style="{StaticResource GhostButton}" HeightRequest="42" Padding="14,0"
                        IsEnabled="{Binding PodePaginaAnterior}" Command="{Binding PaginaAnteriorCommand}" />
                <Label Grid.Column="1" Text="{Binding IndicadorPagina}" Style="{StaticResource BodySm}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Próxima" Style="{StaticResource GhostButton}" HeightRequest="42" Padding="14,0"
                        IsEnabled="{Binding PodePaginaProxima}" Command="{Binding PaginaProximaCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
