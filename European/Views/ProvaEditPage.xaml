<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.ProvaEditPage"
             x:DataType="vm:ProvaEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!--
        Assistente em 3 etapas (Dados → Regras → Questões): "Continuar" valida a etapa atual e
        só a última etapa salva. Na etapa Questões aparece uma questão por vez, com a paginação < >.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <controls:Cabecalho Titulo="{Binding Title}" Margin="20,16,20,12" />

        <!-- indicador de etapas -->
        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="20,0,20,12">
            <Label Text="{Binding EtapaTexto}" Style="{StaticResource BodySm}" TextColor="{DynamicResource BrandPrimary}" FontFamily="TextoNegrito" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" Color="{DynamicResource BrandPrimary}" />
                <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Outline}">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding EtapaRegrasAtingida}" Value="True">
                            <Setter Property="Color" Value="{DynamicResource BrandPrimary}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" Color="{DynamicResource Outline}">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding EtapaQuestoesAtingida}" Value="True">
                            <Setter Property="Color" Value="{DynamicResource BrandPrimary}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="16">

                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource WarningSoft}" Stroke="Transparent"
                        IsVisible="{Binding TemEntregas}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="&#xe002;" Style="{StaticResource Icon}" TextColor="{DynamicResource Warning}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding EntregasTexto}" Style="{StaticResource BodySm}" TextColor="{DynamicResource OnSurface}" />
                    </Grid>
                </Border>

                <!-- Seção 1: dados da prova -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding MostrarDados}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Curso" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Cursos}" SelectedItem="{Binding CursoSelecionado}" Title="Selecione o curso"
                                        ItemDisplayBinding="{Binding Nome, x:DataType=models:Curso}" />
                            </Border>
                            <Label Text="Você ainda não leciona nenhum curso. Peça à coordenação para vincular você." Style="{StaticResource BodySm}"
                                   TextColor="{DynamicResource Danger}" IsVisible="{Binding SemCursos}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Matéria" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Materias}" SelectedItem="{Binding MateriaSelecionada}" Title="Selecione a matéria"
                                        ItemDisplayBinding="{Binding Texto, x:DataType=vm:MateriaOpcao}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Quem faz a prova" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Salas}" SelectedItem="{Binding SalaSelecionada}"
                                        ItemDisplayBinding="{Binding Texto, x:DataType=vm:SalaOpcao}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Título" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding Titulo}" Placeholder="Ex.: Avaliação 1 — Teoria Geral" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Instruções para o aluno (opcional)" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource CampoTexto}">
                                <Editor Text="{Binding Instrucoes}" Placeholder="Ex.: Leia com atenção. Cada questão tem uma única resposta correta."
                                        AutoSize="TextChanges" MinimumHeightRequest="60" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Seção 2: regras e notas -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding MostrarRegras}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tempo (min, 0 = livre)" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding DuracaoMinutos}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="Peso da prova" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding Peso}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="8">
                                <Label Text="Nota máxima" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding NotaMaxima}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="Nota de corte" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding NotaCorte}" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Outline}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Prazo de entrega" Style="{StaticResource BodyMd}" />
                                <Label Text="Depois do prazo, a prova fica indisponível." Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding TemPrazo}" OnColor="{DynamicResource BrandPrimary}" VerticalOptions="Center" />
                        </Grid>

                        <!-- data numa linha; hora : minuto na linha de baixo, com espaço para os seletores -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding TemPrazo}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Data" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <DatePicker Date="{Binding PrazoData}" Format="dd/MM/yyyy" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Horário" Style="{StaticResource BodySm}" />
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                    <Border Style="{StaticResource Campo}" Padding="10,2">
                                        <Picker ItemsSource="{Binding Horas}" SelectedItem="{Binding HoraPrazo}"
                                                HorizontalOptions="Fill" />
                                    </Border>
                                    <Label Grid.Column="1" Text=":" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource Campo}" Padding="10,2">
                                        <Picker ItemsSource="{Binding Minutos}" SelectedItem="{Binding MinutoPrazo}"
                                                HorizontalOptions="Fill" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Publicar para os alunos" Style="{StaticResource BodyMd}" />
                                <Label Text="Desligado, a prova fica salva como rascunho." Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsPublicada}" OnColor="{DynamicResource Success}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Seção 3: questões, uma por vez -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding MostrarQuestoes}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ResumoQuestoes}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Nova questão" Style="{StaticResource SoftButton}" Command="{Binding AdicionarQuestaoCommand}" />
                    </Grid>

                    <Border Style="{StaticResource Card}" BindingContext="{Binding QuestaoAtual}" x:DataType="vm:QuestaoEdicao">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto,64,Auto" ColumnSpacing="8">
                                <Border Style="{StaticResource Pill}" VerticalOptions="Center">
                                    <Label Text="{Binding Numero, StringFormat='Questão {0}'}" FontFamily="TextoNegrito" FontSize="12" TextColor="{DynamicResource BrandPrimary}" />
                                </Border>
                                <Label Grid.Column="2" Text="Peso" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                                <Border Grid.Column="3" Style="{StaticResource Campo}" Padding="8,0">
                                    <Entry Text="{Binding Peso}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                                </Border>
                                <Button Grid.Column="4" Text="&#xe872;" Style="{StaticResource IconButton}" TextColor="{DynamicResource Danger}"
                                        ToolTipProperties.Text="Remover questão"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=RemoverQuestaoAtualCommand, x:DataType=vm:ProvaEditViewModel}" />
                            </Grid>

                            <!-- tipo da questão -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <controls:BotaoSegmento Grid.Column="0" Text="Alternativas" Style="{StaticResource GhostButton}" HeightRequest="38" MinimumHeightRequest="38"
                                        Padding="4,0" FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=TipoQuestaoCommand, x:DataType=vm:ProvaEditViewModel}"
                                        CommandParameter="alternativas" Ativo="{Binding IsAlternativas}" />
                                <controls:BotaoSegmento Grid.Column="1" Text="Dissertativa" Style="{StaticResource GhostButton}" HeightRequest="38" MinimumHeightRequest="38"
                                        Padding="4,0" FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=TipoQuestaoCommand, x:DataType=vm:ProvaEditViewModel}"
                                        CommandParameter="dissertativa" Ativo="{Binding IsDissertativa}" />
                            </Grid>

                            <Border Style="{StaticResource CampoTexto}">
                                <Editor Text="{Binding Enunciado}" Placeholder="Enunciado da questão" AutoSize="TextChanges"
                                        MinimumHeightRequest="50" />
                            </Border>

                            <!-- dissertativa: o aluno escreve; o professor corrige depois -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsDissertativa}">
                                <Label Text="Resposta esperada (opcional, só você vê na correção)" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource CampoTexto}">
                                    <Editor Text="{Binding RespostaEsperada}" Placeholder="Pontos que a resposta deve abordar" AutoSize="TextChanges"
                                            MinimumHeightRequest="50" />
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="Toque na letra para marcar a alternativa correta." Style="{StaticResource BodySm}" IsVisible="{Binding IsAlternativas}" />

                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alternativas}" IsVisible="{Binding IsAlternativas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlternativaEdicao">
                                        <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                                            <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" VerticalOptions="Center"
                                                    Stroke="{DynamicResource Outline}" StrokeThickness="1.5" BackgroundColor="{DynamicResource SurfaceCard}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Correta}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource Success}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=MarcarCorretaCommand, x:DataType=vm:ProvaEditViewModel}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Letra}" FontFamily="TextoNegrito" FontSize="12" TextColor="{DynamicResource OnSurfaceVariant}"
                                                       HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Correta}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource BrandOnPrimaryContainer}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource Campo}">
                                                <Entry Text="{Binding Texto}" Placeholder="Texto da alternativa" />
                                            </Border>
                                            <Button Grid.Column="2" Text="&#xe5cd;" Style="{StaticResource IconButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=RemoverAlternativaCommand, x:DataType=vm:ProvaEditViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Button Text="+ Alternativa" Style="{StaticResource SoftButton}" HorizontalOptions="Start" IsVisible="{Binding IsAlternativas}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaEditViewModel}}, Path=AdicionarAlternativaCommand, x:DataType=vm:ProvaEditViewModel}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- paginação das questões (< 1 / 5 >) -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20"
                                WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="20"
                                BackgroundColor="{DynamicResource SurfaceCard}" TextColor="{DynamicResource OnSurface}"
                                IsEnabled="{Binding PodeQuestaoAnterior}" Command="{Binding QuestaoAnteriorCommand}" />
                        <Label Grid.Column="1" Text="{Binding IndicadorQuestao}" Style="{StaticResource BodySm}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="&#xe5c8;" FontFamily="MaterialIcons" FontSize="20"
                                WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="20"
                                BackgroundColor="{DynamicResource SurfaceCard}" TextColor="{DynamicResource OnSurface}"
                                IsEnabled="{Binding PodeQuestaoProxima}" Command="{Binding QuestaoProximaCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <Button Text="Excluir prova" Style="{StaticResource GhostButton}" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Danger}"
                        Command="{Binding ExcluirCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{StaticResource TodosVerdadeiros}">
                            <Binding Path="IsEdicao" />
                            <Binding Path="MostrarDados" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <!-- rodapé: Voltar / Continuar (na última etapa, "Salvar prova") -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{DynamicResource Outline}" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,12,20,16">
                <Button Grid.Column="0" Text="Voltar" Style="{StaticResource GhostButton}" Command="{Binding VoltarEtapaCommand}"
                        IsVisible="{Binding PodeVoltarEtapa}" />
                <Button Grid.Column="1" Text="{Binding BotaoAvancarTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding AvancarCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Grid>

    </Grid>

</views:BasePage>
