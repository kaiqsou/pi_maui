<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             x:Class="European.Views.CertificadosPage"
             x:DataType="vm:CertificadoViewModel"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" Padding="20,24,20,0" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Certificados" Style="{StaticResource TitleLg}" />
            <Label Text="Certificados de curso e de matéria" Style="{StaticResource Muted}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Certificados}" SelectionMode="None" IsVisible="{Binding PossuiCertificado}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Certificado">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CertificadoViewModel}}, Path=AbrirCommand, x:DataType=vm:CertificadoViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="&#xea3f;" Style="{StaticResource Icon}" TextColor="{StaticResource Warning}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Titulo}" Style="{StaticResource TitleSm}" />
                                <Label Text="{Binding TipoTexto}" Style="{StaticResource BodySm}" />
                                <Label Text="{Binding CodigoVerificacao}" Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#xe5cc;" Style="{StaticResource Icon}" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding PossuiCertificado, Converter={StaticResource InverseBool}}">
            <Label Text="&#xea3f;" Style="{StaticResource Icon}" FontSize="48" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
            <Label Text="Nenhum certificado ainda" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
            <Label Text="Conclua um curso ou uma matéria para emitir seus certificados." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentView>
