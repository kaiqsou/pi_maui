<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.CertificadosPage"
             x:DataType="vm:CertificadoViewModel"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Certificado" Style="{StaticResource TitleLg}" />
                <Label Text="Certificado de conclusão do mestrado" Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <!-- Certificado emitido -->
            <Border Style="{StaticResource Card}" Padding="24" IsVisible="{Binding PossuiCertificado}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12">
                    <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                            BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Label Text="&#xea3f;" Style="{StaticResource Icon}" FontSize="38"
                               TextColor="{StaticResource Warning}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="EUROPEAN" Style="{StaticResource BodySm}" HorizontalOptions="Center" />
                    <Label Text="{Binding Certificado.CursoNome}" Style="{StaticResource TitleMd}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Certificado.AlunoNome}" Style="{StaticResource TitleSm}" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource BrandPrimary}" />
                    <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Emissão" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding EmissaoTexto}" Style="{StaticResource TitleSm}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Média final" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding MediaTexto}" Style="{StaticResource TitleSm}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Código" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Certificado.CodigoVerificacao}" Style="{StaticResource TitleSm}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent"
                    IsVisible="{Binding PossuiValidade}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="&#xe8b5;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ValidadeTexto}" Style="{StaticResource BodySm}"
                           TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="Baixar PDF" Style="{StaticResource PrimaryButton}"
                    Command="{Binding BaixarPdfCommand}" IsVisible="{Binding PossuiCertificado}" />

            <!-- Ainda não emitido -->
            <Border Style="{StaticResource Card}" Padding="24" IsVisible="{Binding Pendente}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="&#xea3f;" Style="{StaticResource Icon}" FontSize="48" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
                    <Label Text="Certificado ainda não disponível" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
                    <Label Text="{Binding CursoNome}" Style="{StaticResource BodyMd}" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource BrandPrimary}" />
                    <Label Text="O certificado é emitido após concluir todos os módulos e ser aprovado pela média em todas as matérias."
                           Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18">
                <Border.IsVisible>
                    <MultiBinding Converter="{StaticResource TodosVerdadeiros}">
                        <Binding Path="Pendente" />
                        <Binding Path="PossuiSituacao" />
                    </MultiBinding>
                </Border.IsVisible>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Requisitos" Style="{StaticResource TitleSm}" />

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Módulos concluídos" Style="{StaticResource BodyMd}" />
                            <Label Grid.Column="1" Text="{Binding ModulosTexto}" Style="{StaticResource TitleSm}" />
                            <Label Grid.Column="2" Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="18"
                                   TextColor="{StaticResource Success}" IsVisible="{Binding ModulosOk}" />
                        </Grid>
                        <ProgressBar Progress="{Binding ModulosPercentual, Converter={StaticResource PercentToProgress}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Matérias aprovadas (pela média)" Style="{StaticResource BodyMd}" />
                            <Label Grid.Column="1" Text="{Binding MateriasTexto}" Style="{StaticResource TitleSm}" />
                            <Label Grid.Column="2" Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="18"
                                   TextColor="{StaticResource Success}" IsVisible="{Binding MateriasOk}" />
                        </Grid>
                        <ProgressBar Progress="{Binding MateriasPercentual, Converter={StaticResource PercentToProgress}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
