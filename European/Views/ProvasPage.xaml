<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.ProvasPage"
             x:DataType="vm:ProvasViewModel"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,24,20,0" RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Provas" Style="{StaticResource TitleLg}" />
            <Label Text="Avaliações disponíveis e realizadas" Style="{StaticResource Muted}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Disponíveis" Command="{Binding SelecionarAbaCommand}" CommandParameter="disponiveis" Style="{StaticResource GhostButton}" HeightRequest="42">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding MostrarDisponiveis}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Realizadas" Command="{Binding SelecionarAbaCommand}" CommandParameter="realizadas" Style="{StaticResource GhostButton}" HeightRequest="42">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding MostrarRealizadas}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Disponiveis}" SelectionMode="None" IsVisible="{Binding MostrarDisponiveis}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProvaItem">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                        BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                    <Label Text="&#xe862;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TitleSm}" />
                                    <Label Text="{Binding MateriaNome}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="&#xe878;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Grid.Column="1" Text="{Binding Prazo}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Duracao}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Realizadas}" SelectionMode="None" IsVisible="{Binding MostrarRealizadas}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultadoItem">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding ProvaTitulo}" Style="{StaticResource TitleSm}" />
                                <Label Text="{Binding MateriaNome}" Style="{StaticResource BodySm}" />
                                <Label Text="{Binding Data}" Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalOptions="Center">
                                <Label Text="{Binding Nota, StringFormat='{0:0.0}'}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource BrandPrimary}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding MostrarVazioDisponiveis}">
            <Label Text="&#xe862;" Style="{StaticResource Icon}" FontSize="48" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
            <Label Text="Nenhuma prova disponível" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
            <Label Text="No momento não há avaliações abertas. Volte em breve." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding MostrarVazioRealizadas}">
            <Label Text="&#xe862;" Style="{StaticResource Icon}" FontSize="48" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
            <Label Text="Nenhuma prova realizada" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
            <Label Text="As avaliações que você fizer aparecerão aqui." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentView>
