<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.AulaEditPage"
             x:DataType="vm:AulaEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho fixo; só o conteúdo abaixo dele rola -->
    <Grid RowDefinitions="Auto,*">
        <controls:Cabecalho Titulo="{Binding Title}" Subtitulo="{Binding MateriaNome}" Margin="20,16,20,12" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,4,20,28" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Label Text="Título" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Titulo}" Placeholder="Título da aula" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource CampoTexto}">
                    <Editor Text="{Binding Descricao}" Placeholder="O que será abordado" HeightRequest="80" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Link do vídeo no YouTube" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding VideoUrl}" Placeholder="https://www.youtube.com/watch?v=..." Keyboard="Url" />
                </Border>
                <Label Text="Link do YouTube não reconhecido." Style="{StaticResource BodySm}" TextColor="{StaticResource Danger}"
                       IsVisible="{Binding VideoInvalido}" />
                <Label Text="Use vídeos públicos ou não listados com incorporação permitida." Style="{StaticResource BodySm}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Duração aproximada (min) — opcional, o player detecta a duração real" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}" WidthRequest="140" HorizontalOptions="Start">
                    <Entry Text="{Binding DuracaoMinutos}" Keyboard="Numeric" Placeholder="0" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Salvar aula" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <!-- Materiais complementares (disponível depois que a aula existe) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEdicao}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Materiais da aula" Style="{StaticResource TitleSm}" />
                        <Label Text="Arquivos ficam guardados no banco e os alunos podem baixá-los." Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Materiais}">
                        <BindableLayout.EmptyView>
                            <Label Text="Nenhum material anexado." Style="{StaticResource Muted}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MaterialComplementar">
                                <Border Style="{StaticResource Painel}" Padding="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Text="&#xe873;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Titulo}" Style="{StaticResource BodyMd}" />
                                            <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="&#xe872;" Style="{StaticResource IconButton}" TextColor="{StaticResource Danger}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AulaEditViewModel}}, Path=RemoverMaterialCommand, x:DataType=vm:AulaEditViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Enviar arquivo" Style="{StaticResource SoftButton}" Command="{Binding AdicionarArquivoCommand}" />
                        <Button Grid.Column="1" Text="Adicionar link" Style="{StaticResource SoftButton}" Command="{Binding AdicionarLinkCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>

</views:BasePage>
