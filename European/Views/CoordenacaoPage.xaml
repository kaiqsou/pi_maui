<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.CoordenacaoPage"
             x:DataType="vm:CoordenacaoViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ContentPage.Resources>
        <!-- Item de pessoa (aluno/professor) com chip de status -->
        <DataTemplate x:Key="PessoaTemplate" x:DataType="vm:PessoaItem">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Abrir}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                        <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" TextColor="{StaticResource BrandPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                        <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Start" BackgroundColor="{StaticResource SuccessSoft}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Alerta}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Outline}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Destaque}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource WarningSoft}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Status}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource OnSurface}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Filtro" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceCard}" />
            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
            <Setter Property="BorderColor" Value="{StaticResource Outline}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,24,20,8">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Saudacao}" Style="{StaticResource TitleLg}" />
                <Label Text="Coordenação" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource BackTile}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                </Border.GestureRecognizers>
                <Label Text="&#xe7fd;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Cursos -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Cursos}" SelectionMode="None" IsVisible="{Binding MostrarCursos}" Margin="20,8,20,0">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Cursos" Style="{StaticResource TitleSm}" />
                        <Label Text="Crie e organize módulos e matérias." Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Novo curso" Style="{StaticResource SoftButton}" Command="{Binding NovoCursoCommand}" VerticalOptions="Center" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CursoResumo">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordenacaoViewModel}}, Path=AbrirCursoCommand, x:DataType=vm:CoordenacaoViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}">
                                <Label Text="&#xe80c;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                                <Label Text="{Binding Estrutura}" Style="{StaticResource BodySm}" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="&#xe872;" Style="{StaticResource IconButton}" TextColor="{StaticResource Danger}" VerticalOptions="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordenacaoViewModel}}, Path=ExcluirCursoCommand, x:DataType=vm:CoordenacaoViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Alunos -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Padding="20,8,20,0" IsVisible="{Binding MostrarAlunos}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Alunos" Style="{StaticResource TitleSm}" />
                    <Label Text="Libere o acesso pelo e-mail cadastrado." Style="{StaticResource BodySm}" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Liberar por e-mail" Style="{StaticResource PrimaryButton}" FontSize="13" MinimumHeightRequest="42" Padding="8"
                        Command="{Binding LiberarPorEmailCommand}" />
                <Button Grid.Column="1" Text="Criar conta" Style="{StaticResource GhostButton}" FontSize="13" MinimumHeightRequest="42" Padding="8"
                        Command="{Binding CriarContaAlunoCommand}" />
            </Grid>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Border Style="{StaticResource Campo}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="&#xe8b6;" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry Grid.Column="1" Text="{Binding Busca}" Placeholder="Buscar por nome ou e-mail" TextColor="{StaticResource OnSurface}" />
                    </Grid>
                </Border>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding PendentesTexto}" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="pendentes">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroPendentes}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Ativos" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="ativos">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroAtivos}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Todos" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="todos">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltroTodos}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <CollectionView Grid.Row="3" ItemsSource="{Binding Alunos}" SelectionMode="None" ItemTemplate="{StaticResource PessoaTemplate}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="0,30" HorizontalOptions="Center">
                        <Label Text="&#xe7fb;" Style="{StaticResource Icon}" FontSize="44" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
                        <Label Text="Nenhum aluno encontrado" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Professores -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Professores}" SelectionMode="None" IsVisible="{Binding MostrarProfessores}" Margin="20,8,20,0"
                        ItemTemplate="{StaticResource PessoaTemplate}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Professores" Style="{StaticResource TitleSm}" />
                        <Label Text="Acesso ao app e cursos de cada professor." Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Adicionar" Style="{StaticResource SoftButton}" Command="{Binding AdicionarProfessorCommand}" VerticalOptions="Center" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Padding="0,40" HorizontalOptions="Center">
                    <Label Text="&#xe7fb;" Style="{StaticResource Icon}" FontSize="48" TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
                    <Label Text="Nenhum professor cadastrado" Style="{StaticResource TitleSm}" HorizontalOptions="Center" />
                    <Label Text="Use Adicionar para criar ou liberar a conta de um professor." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandPrimary}"
                           VerticalOptions="Start" HeightRequest="24" />

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Padding="4,10,4,12">
                <controls:AbaBotao Icone="&#xe80c;" Texto="Cursos" Ativa="{Binding MostrarCursos}"
                                   Command="{Binding SelecionarAbaCommand}" CommandParameter="cursos" />
                <controls:AbaBotao Grid.Column="1" Icone="&#xe7fb;" Texto="Alunos" Ativa="{Binding MostrarAlunos}"
                                   Command="{Binding SelecionarAbaCommand}" CommandParameter="alunos" />
                <controls:AbaBotao Grid.Column="2" Icone="&#xe7ef;" Texto="Professores" Ativa="{Binding MostrarProfessores}"
                                   Command="{Binding SelecionarAbaCommand}" CommandParameter="professores" />
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
