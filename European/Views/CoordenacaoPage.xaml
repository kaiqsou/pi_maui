<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.CoordenacaoPage"
             x:DataType="vm:CoordenacaoViewModel"
             Shell.NavBarIsVisible="False">

    <views:BasePage.Resources>
        <!-- Item de pessoa (aluno/professor) com chip de status -->
        <DataTemplate x:Key="PessoaTemplate" x:DataType="vm:PessoaItem">
            <Border Style="{StaticResource Card}" Margin="20,0,20,10" Padding="14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Abrir}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                        <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" TextColor="{StaticResource BrandPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                        <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Start" BackgroundColor="{StaticResource SuccessSoft}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Alerta}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Outline}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Destaque}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource WarningSoft}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Status}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource OnSurface}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Filtro" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceCard}" />
            <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
            <Setter Property="BorderColor" Value="{StaticResource Outline}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </views:BasePage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="20,24,20,8">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Saudacao}" Style="{StaticResource TitleLg}" />
                <Label Text="Coordenação" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <controls:SinoNotificacoes Grid.Column="1" BindingContext="{Binding Sino}" VerticalOptions="Center" />
            <Border Grid.Column="2" Style="{StaticResource BackTile}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                </Border.GestureRecognizers>
                <Label Text="&#xe7fd;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!--
            Em cada aba o cabeçalho fica fixo e só a lista rola. A margem lateral fica nos itens,
            para a barra de rolagem ficar na borda e não passar por cima dos cards.
        -->

        <!-- Cursos -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12" Padding="0,8,0,0" IsVisible="{Binding MostrarCursos}">
            <Grid ColumnDefinitions="*,Auto" Margin="20,0">
                <Label Text="Cursos" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Novo curso" Style="{StaticResource SoftButton}" Command="{Binding NovoCursoCommand}" VerticalOptions="Center" />
            </Grid>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Cursos}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CursoResumo">
                        <Border Style="{StaticResource Card}" Margin="20,0,20,10" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordenacaoViewModel}}, Path=AbrirCursoCommand, x:DataType=vm:CoordenacaoViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                                    <Label Text="&#xe80c;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Estrutura}" Style="{StaticResource BodySm}" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="&#xe5cc;" Style="{StaticResource Icon}" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <controls:EstadoVazio Icone="&#xe80c;" Titulo="Nenhum curso criado" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Alunos -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="0,8,0,0" IsVisible="{Binding MostrarAlunos}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,0">
                <Label Text="Alunos" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Liberar" Style="{StaticResource SoftButton}" ToolTipProperties.Text="Liberar acesso pelo e-mail"
                        Command="{Binding LiberarPorEmailCommand}" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Nova conta" Style="{StaticResource SoftButton}" Command="{Binding CriarContaAlunoCommand}" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="20,0">
                <Border Style="{StaticResource Campo}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="&#xe8b6;" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry Grid.Column="1" Text="{Binding Busca}" Placeholder="Buscar por nome ou e-mail" />
                    </Grid>
                </Border>
                <HorizontalStackLayout Spacing="8">
                    <controls:BotaoSegmento Text="{Binding PendentesTexto}" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="pendentes" Ativo="{Binding FiltroPendentes}" />
                    <controls:BotaoSegmento Text="Ativos" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="ativos" Ativo="{Binding FiltroAtivos}" />
                    <controls:BotaoSegmento Text="Todos" Style="{StaticResource Filtro}" Command="{Binding FiltrarAlunosCommand}" CommandParameter="todos" Ativo="{Binding FiltroTodos}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Alunos}" SelectionMode="None" ItemTemplate="{StaticResource PessoaTemplate}">
                <CollectionView.EmptyView>
                    <controls:EstadoVazio Icone="&#xe7fb;" Titulo="Nenhum aluno encontrado" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Professores -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12" Padding="0,8,0,0" IsVisible="{Binding MostrarProfessores}">
            <Grid ColumnDefinitions="*,Auto" Margin="20,0">
                <Label Text="Professores" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Adicionar" Style="{StaticResource SoftButton}" Command="{Binding AdicionarProfessorCommand}" VerticalOptions="Center" />
            </Grid>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Professores}" SelectionMode="None" ItemTemplate="{StaticResource PessoaTemplate}">
                <CollectionView.EmptyView>
                    <controls:EstadoVazio Icone="&#xe7fb;" Titulo="Nenhum professor cadastrado" Texto="Use Adicionar para criar ou liberar a conta de um professor." />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" />

        <controls:BarraAbas Grid.Row="2">
            <controls:AbaBotao Icone="&#xe80c;" Texto="Cursos" Ativa="{Binding MostrarCursos}"
                               Command="{Binding SelecionarAbaCommand}" CommandParameter="cursos" />
            <controls:AbaBotao Icone="&#xe7fb;" Texto="Alunos" Ativa="{Binding MostrarAlunos}"
                               Command="{Binding SelecionarAbaCommand}" CommandParameter="alunos" />
            <controls:AbaBotao Icone="&#xe7ef;" Texto="Professores" Ativa="{Binding MostrarProfessores}"
                               Command="{Binding SelecionarAbaCommand}" CommandParameter="professores" />
        </controls:BarraAbas>

    </Grid>

</views:BasePage>
