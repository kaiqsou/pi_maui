<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.CorrecaoPage"
             x:DataType="vm:CorrecaoViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <!-- Às cegas: sem nome, e-mail nem horário. Cabeçalho e nota fixos; questões rolam; botões fixos embaixo. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <controls:Cabecalho Titulo="{Binding Title}" Subtitulo="Correção às cegas" Margin="20,16,20,12" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12" BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent">
            <Label Text="{Binding NotaTotalTexto}" Style="{StaticResource BodyMd}" FontFamily="OpenSansSemibold" />
        </Border>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="12" BindableLayout.ItemsSource="{Binding Questoes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestaoCorrecao">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Style="{StaticResource Pill}" VerticalOptions="Start">
                                        <Label Text="{Binding Numero}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Enunciado}" Style="{StaticResource BodyMd}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="2" Text="{Binding PesoTexto}" Style="{StaticResource BodySm}" />
                                </Grid>

                                <!-- alternativas: já corrigida -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAlternativas}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource Success}" IsVisible="{Binding Acertou}" />
                                        <Label Text="&#xe5c9;" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource Danger}" IsVisible="{Binding Errou}" />
                                        <Label Grid.Column="1" Style="{StaticResource BodySm}" TextColor="{StaticResource OnSurface}" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Marcou: " FontFamily="OpenSansSemibold" />
                                                    <Span Text="{Binding MarcadaTexto}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                    <Label Style="{StaticResource BodySm}" IsVisible="{Binding Errou}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Correta: " FontFamily="OpenSansSemibold" />
                                                <Span Text="{Binding CorretaTexto}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- dissertativa: professor corrige -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsDissertativa}">
                                    <Border Style="{StaticResource Painel}" Padding="12">
                                        <Label Text="{Binding RespostaAluno}" Style="{StaticResource BodyMd}" />
                                    </Border>
                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding TemRespostaEsperada}">
                                        <Label Text="Resposta esperada" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding RespostaEsperada}" Style="{StaticResource BodySm}" />
                                    </VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,80" ColumnSpacing="10">
                                        <Label Text="Nota (0 a 10)" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource Campo}" Padding="8,0">
                                            <Entry Text="{Binding Nota}" Keyboard="Numeric" HorizontalTextAlignment="Center" Placeholder="—"
                                                   TextColor="{StaticResource OnSurface}" />
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource CampoTexto}">
                                        <Editor Text="{Binding Comentario}" Placeholder="Comentário para o aluno (opcional)" AutoSize="TextChanges"
                                                MinimumHeightRequest="50" TextColor="{StaticResource OnSurface}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,12,20,16">
                <Button Grid.Column="0" Text="Salvar" Style="{StaticResource GhostButton}" Command="{Binding SalvarCommand}"
                        IsVisible="{Binding JaCorrigida, Converter={StaticResource InverseBool}}" />
                <Button Grid.Column="1" Text="{Binding ConcluirTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding ConcluirCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
