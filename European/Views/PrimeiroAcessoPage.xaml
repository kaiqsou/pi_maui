<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.PrimeiroAcessoPage"
             x:DataType="vm:PrimeiroAcessoViewModel"
             Title="Configurar coordenação"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,32,28,28" Spacing="18">

            <Border Style="{StaticResource IconTile}" WidthRequest="64" HeightRequest="64" HorizontalOptions="Start">
                <Label Text="&#xe8b8;" Style="{StaticResource IconPrimary}" FontSize="32"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Configurar coordenação" Style="{StaticResource TitleLg}" />
            <Label Text="Crie a conta da coordenação. Com ela você cadastra cursos, professores e libera o acesso dos alunos."
                   Style="{StaticResource Muted}" />

            <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                <Label Text="Nome completo" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Nome}" Placeholder="Nome do coordenador" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="E-mail" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Email}" Placeholder="coordenacao@instituicao.com" Keyboard="Email" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Senha" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Senha}" Placeholder="Letras e números, mínimo 6" IsPassword="True" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Confirmar senha" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding ConfirmacaoSenha}" IsPassword="True" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding Mensagem}" IsVisible="{Binding TemMensagem}"
                   TextColor="{StaticResource Danger}" FontSize="13" />

            <Button Text="Criar conta da coordenação" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConfigurarCoordenacaoCommand}" Margin="0,8,0,0"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Voltar ao login" Style="{StaticResource GhostButton}"
                    Command="{Binding IrParaLoginCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
