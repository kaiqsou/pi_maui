<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             x:Class="European.Views.CatalogoPage"
             x:DataType="vm:CatalogoViewModel"
             Title="Catálogo de Cursos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Catálogo de Cursos" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
            </Grid>

            <Label Text="Escolha um curso para começar a estudar." Style="{StaticResource Muted}" />

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Cursos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Curso">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogoViewModel}}, Path=AbrirCommand, x:DataType=vm:CatalogoViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                                        <Label Text="{Binding Categoria}" Style="{StaticResource BodySm}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Preco, StringFormat='{0:C}'}"
                                           FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Descricao}" Style="{StaticResource Muted}" />
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                    <Label Grid.Column="0" Text="&#xe8b5;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <Label Grid.Column="1" Text="{Binding CargaHorariaHoras, StringFormat='{0} horas'}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="Ver detalhes" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>