<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.CursoEditPage"
             x:DataType="vm:CursoEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho fixo; só o conteúdo abaixo dele rola -->
    <Grid RowDefinitions="Auto,*">
        <controls:Cabecalho Titulo="{Binding Title}" Margin="20,16,20,12" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,4,20,28" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Label Text="Nome" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Nome}" Placeholder="Ex.: Mestrado em Direito Penal Econômico" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource CampoTexto}">
                    <Editor Text="{Binding Descricao}" Placeholder="Uma ou duas frases sobre o curso" HeightRequest="80" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categoria" Style="{StaticResource BodySm}" />
                    <Border Style="{StaticResource Campo}">
                        <Picker ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}" TextColor="{StaticResource OnSurface}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Carga horária (h)" Style="{StaticResource BodySm}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding CargaHoraria}" Keyboard="Numeric" TextColor="{StaticResource OnSurface}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Curso ativo" Style="{StaticResource BodyMd}" />
                        <Label Text="Cursos inativos não aparecem para liberação de novos alunos." Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding IsPublicado}" OnColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="Salvar" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>

</views:BasePage>
