<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.AguardandoAcessoPage"
             x:DataType="vm:AcessoRestritoViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,28" Spacing="18">

            <!-- Aguardando -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding MostrarAguardando}">
                <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                        BackgroundColor="{DynamicResource WarningSoft}">
                    <Label Text="&#xe88b;" Style="{StaticResource Icon}" FontSize="36" TextColor="{DynamicResource Warning}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding AguardandoTitulo}" Style="{StaticResource TitleLg}" HorizontalOptions="Center" />
                <Label Text="{Binding AguardandoTexto}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Devolvida: a coordenação pediu correções -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding TemPendencia}">
                <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                        BackgroundColor="{DynamicResource DangerSoft}">
                    <Label Text="&#xe000;" Style="{StaticResource Icon}" FontSize="36" TextColor="{DynamicResource Danger}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Correção necessária" Style="{StaticResource TitleLg}" HorizontalOptions="Center" />
                <Label Text="A coordenação analisou sua matrícula e pediu correções. Envie o que falta para continuar."
                       Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource DangerSoft}" Stroke="Transparent">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Motivo" Style="{StaticResource BodySm}" TextColor="{DynamicResource Danger}" FontFamily="TextoNegrito" />
                        <Label Text="{Binding PendenciaTexto}" Style="{StaticResource BodyMd}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Corrigir documentos" Style="{StaticResource PrimaryButton}" Command="{Binding CorrigirDocumentosCommand}" />
            </VerticalStackLayout>

            <!-- Cancelada (pela coordenação ou desistência), com o reembolso -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding Cancelada}">
                <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                        BackgroundColor="{DynamicResource DangerSoft}">
                    <Label Text="&#xe5c9;" Style="{StaticResource Icon}" FontSize="36" TextColor="{DynamicResource Danger}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Solicitação cancelada" Style="{StaticResource TitleLg}" HorizontalOptions="Center" />
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource DangerSoft}" Stroke="Transparent">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Motivo" Style="{StaticResource BodySm}" TextColor="{DynamicResource Danger}" FontFamily="TextoNegrito" />
                        <Label Text="{Binding CanceladaTexto}" Style="{StaticResource BodyMd}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" IsVisible="{Binding TemReembolso}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource Success}" />
                        <Label Grid.Column="1" Text="{Binding ReembolsoTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Button Text="Fazer novo cadastro" Style="{StaticResource PrimaryButton}" Command="{Binding NovoCadastroCommand}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource BrandPrimary}">
                        <Label Text="{Binding Iniciais}" FontFamily="TextoNegrito" FontSize="16" TextColor="{DynamicResource BrandOnPrimaryContainer}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Pedido de matrícula: curso escolhido e pagamento -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding TemPedido}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xe80c;" Style="{StaticResource IconPrimary}" FontSize="20" />
                        <Label Grid.Column="1" Text="{Binding CursoNome}" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding Pago}">
                        <Label Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="20" TextColor="{DynamicResource Success}" />
                        <Label Grid.Column="1" Text="{Binding PagamentoTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Informe este e-mail à coordenação do seu curso." Style="{StaticResource BodySm}" HorizontalOptions="Center"
                   IsVisible="{Binding TemPedido, Converter={StaticResource InverseBool}}" />

            <Button Text="Verificar novamente" Style="{StaticResource PrimaryButton}" Command="{Binding VerificarCommand}"
                    IsVisible="{Binding MostrarAguardando}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Desistir da matrícula" Style="{StaticResource GhostButton}" Command="{Binding DesistirCommand}"
                    TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Danger}" IsVisible="{Binding PodeDesistir}" />
            <Button Text="Sair" Style="{StaticResource GhostButton}" Command="{Binding SairCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
