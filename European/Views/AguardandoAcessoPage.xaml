<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.AguardandoAcessoPage"
             x:DataType="vm:AcessoRestritoViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,28" Spacing="18">

            <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                    BackgroundColor="{StaticResource WarningSoft}">
                <Label Text="&#xe88b;" Style="{StaticResource Icon}" FontSize="36" TextColor="{StaticResource Warning}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Aguardando liberação" Style="{StaticResource TitleLg}" HorizontalOptions="Center" />
            <Label Text="Seu cadastro foi recebido. Assim que a coordenação liberar o seu acesso ao curso, as aulas e provas aparecerão aqui."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource BrandPrimary}">
                        <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Informe este e-mail à coordenação do seu curso." Style="{StaticResource BodySm}" HorizontalOptions="Center" />

            <Button Text="Verificar novamente" Style="{StaticResource PrimaryButton}" Command="{Binding VerificarCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandPrimary}" HeightRequest="24" />
            <Button Text="Sair" Style="{StaticResource GhostButton}" Command="{Binding SairCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
