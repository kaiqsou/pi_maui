<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:views="clr-namespace:European.Views"
             x:Class="European.Views.SomenteCertificadosPage"
             x:DataType="vm:AcessoRestritoViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,20,20,0">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Nome}" Style="{StaticResource TitleMd}" />
                <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Sair" Style="{StaticResource SoftButton}" Command="{Binding SairCommand}" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,16,20,0" BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="&#xe88e;" Style="{StaticResource IconPrimary}" VerticalOptions="Start" />
                    <Label Grid.Column="1" Style="{StaticResource BodySm}" TextColor="{StaticResource OnSurface}" Text="{Binding AvisoTexto}" />
                </Grid>
                <Button Text="Reabrir matrícula" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ReabrirMatriculaCommand}" IsVisible="{Binding TemMatriculaTrancada}" />
            </VerticalStackLayout>
        </Border>

        <views:CertificadosAba Grid.Row="2" x:Name="Certificados" />

    </Grid>

</views:BasePage>
