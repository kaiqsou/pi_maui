<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.ProfessorAcessoPage"
             x:DataType="vm:ProfessorAcessoViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho fixo; só o conteúdo abaixo dele rola -->
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:Cabecalho Titulo="Professor" Margin="20,16,20,12" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="16">

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" WidthRequest="52" HeightRequest="52" BackgroundColor="{StaticResource BrandPrimary}">
                            <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource BrandOnPrimaryContainer}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                            <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                            <Label Text="{Binding StatusTexto}" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Danger}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding AcessoLiberado}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="{Binding ResumoTexto}" Style="{StaticResource BodySm}" HorizontalOptions="Center" />

                <!-- Cursos: o professor só cadastra aulas e provas nos cursos marcados -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cursos que leciona" Style="{StaticResource TitleSm}" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cursos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CursoAtribuicao">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                                        <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                                        <Switch Grid.Column="1" IsToggled="{Binding Atribuido}" OnColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Turmas criadas pelo professor -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Turmas" Style="{StaticResource TitleSm}" />
                    <Border Style="{StaticResource Card}" Padding="14,4" IsVisible="{Binding TemTurmas}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Turmas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TurmaResumo">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                        <Label Text="&#xe7ef;" Style="{StaticResource IconPrimary}" FontSize="20" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" FontFamily="OpenSansSemibold" />
                                            <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Nenhuma turma criada." Style="{StaticResource Muted}"
                           IsVisible="{Binding TemTurmas, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>

                <!-- Provas criadas pelo professor; toque abre as notas -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Provas" Style="{StaticResource TitleSm}" />
                    <Border Style="{StaticResource Card}" Padding="14,4" IsVisible="{Binding TemProvas}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Provas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProvaDoProfessor">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfessorAcessoViewModel}}, Path=AbrirProvaCommand, x:DataType=vm:ProfessorAcessoViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="&#xe862;" Style="{StaticResource Icon}" FontSize="20" TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Titulo}" Style="{StaticResource BodyMd}" FontFamily="OpenSansSemibold" />
                                            <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" BackgroundColor="{StaticResource Outline}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Publicada}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StatusTexto}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource OnSurface}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Nenhuma prova criada." Style="{StaticResource Muted}"
                           IsVisible="{Binding TemProvas, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>

                <Button Text="Redefinir senha" Style="{StaticResource GhostButton}" Command="{Binding RedefinirSenhaCommand}" />
                <Button Text="{Binding AcessoBotaoTexto}" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}"
                        Command="{Binding AlternarAcessoCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AcessoLiberado}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Button Grid.Row="1" Text="Salvar cursos" Style="{StaticResource PrimaryButton}" Margin="20,12,20,16"
                    Command="{Binding SalvarCommand}" IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>

</views:BasePage>
