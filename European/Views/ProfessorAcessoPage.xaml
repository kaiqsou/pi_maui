<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.ProfessorAcessoPage"
             x:DataType="vm:ProfessorAcessoViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

                <controls:Cabecalho Titulo="Professor" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" WidthRequest="52" HeightRequest="52" BackgroundColor="{StaticResource BrandPrimary}">
                            <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                            <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                            <Label Text="{Binding StatusTexto}" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Danger}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding AcessoLiberado}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Cursos que leciona" Style="{StaticResource TitleSm}" />
                    <Label Text="O professor só cadastra aulas e provas nos cursos marcados." Style="{StaticResource BodySm}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Cursos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CursoAtribuicao">
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding Atribuido}" OnColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Redefinir senha" Style="{StaticResource GhostButton}" Command="{Binding RedefinirSenhaCommand}" />
                <Button Text="{Binding AcessoBotaoTexto}" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}"
                        Command="{Binding AlternarAcessoCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding AcessoLiberado}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Button Grid.Row="1" Text="Salvar cursos" Style="{StaticResource PrimaryButton}" Margin="20,12,20,16"
                    Command="{Binding SalvarCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
    </Grid>

</ContentPage>
