<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Title="Perfil"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Perfil" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
            </Grid>

            <!-- Identificação -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Grid.Column="0" WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource BrandPrimary}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                        <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Nome}" Style="{StaticResource TitleMd}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Email}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                        <Border Style="{StaticResource Pill}" HorizontalOptions="Start" Margin="0,4,0,0">
                            <Label Text="{Binding RoleTexto}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource BrandPrimary}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Matrícula (aluno) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding TemMatricula}">
                <Label Text="Minha matrícula" Style="{StaticResource TitleSm}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding CursoNome}" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CursoConcluido}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding SituacaoTexto}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource BrandPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CursoConcluido}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Progresso" Style="{StaticResource Muted}" />
                                <Label Grid.Column="1" Text="{Binding Progresso, Converter={StaticResource PercentageText}}" Style="{StaticResource TitleSm}" />
                            </Grid>
                            <ProgressBar Progress="{Binding Progresso, Converter={StaticResource PercentToProgress}}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Matriculado em" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding MatriculadoEmTexto}" Style="{StaticResource BodyMd}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding TemTurma}">
                            <Label Grid.Column="0" Text="Turma" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding TurmaTexto}" Style="{StaticResource BodyMd}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding TemAcessoAte}">
                            <Label Grid.Column="0" Text="Aulas disponíveis até" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding AcessoAteTexto}" Style="{StaticResource BodyMd}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Conta -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Conta" Style="{StaticResource TitleSm}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Membro desde" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding MembroDesdeTexto}" Style="{StaticResource BodyMd}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding TemNascimento}">
                            <Label Grid.Column="0" Text="Data de nascimento" Style="{StaticResource Muted}" />
                            <Label Grid.Column="1" Text="{Binding NascimentoTexto}" Style="{StaticResource BodyMd}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AlternarSenhaCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="&#xe897;" Style="{StaticResource IconPrimary}" FontSize="20" />
                            <Label Grid.Column="1" Text="Alterar senha" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding SetaSenha}" Style="{StaticResource Icon}" TextColor="{StaticResource OnSurfaceVariant}" />
                        </Grid>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding AlterandoSenha}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Senha atual" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding SenhaAtual}" IsPassword="True" TextColor="{StaticResource OnSurface}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nova senha" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding NovaSenha}" Placeholder="Letras e números, mínimo 6" IsPassword="True" TextColor="{StaticResource OnSurface}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Confirmar nova senha" Style="{StaticResource BodySm}" />
                                <Border Style="{StaticResource Campo}">
                                    <Entry Text="{Binding ConfirmacaoSenha}" IsPassword="True" TextColor="{StaticResource OnSurface}" />
                                </Border>
                            </VerticalStackLayout>
                            <Label Text="{Binding MensagemSenha}" Style="{StaticResource BodySm}" TextColor="{StaticResource Danger}"
                                   IsVisible="{Binding TemMensagemSenha}" />
                            <Button Text="Salvar nova senha" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarSenhaCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button Text="Sair da conta" Style="{StaticResource GhostButton}" Command="{Binding LogoutCommand}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
