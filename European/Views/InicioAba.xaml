<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:European.Controls"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.InicioAba"
             x:DataType="vm:InicioViewModel"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Saudacao}" Style="{StaticResource TitleLg}" />
                    <Label Text="{Binding UltimaCursoNome}" Style="{StaticResource Muted}" IsVisible="{Binding TemCurso}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe7fd;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Continuar: leva direto à aula em que o aluno parou (e ao minuto em que parou) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding TemUltimaAula}">
                <Label Text="{Binding CardTitulo}" Style="{StaticResource TitleSm}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="&#xe037;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding UltimaAula.Titulo}" Style="{StaticResource TitleSm}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding UltimaAula.Materia.Nome}" Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <ProgressBar Progress="{Binding UltimaPercentual, Converter={StaticResource PercentToProgress}}"
                                         IsVisible="{Binding UltimaIniciada}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xe8b5;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Grid.Column="1" Text="{Binding UltimaDuracao}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                        <Button Text="{Binding BotaoTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinuarCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Todas as aulas concluídas -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarIniciarAulas}">
                <Label Text="{Binding CardTitulo}" Style="{StaticResource TitleSm}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{StaticResource SuccessSoft}" Stroke="Transparent"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Label Text="&#xe876;" Style="{StaticResource Icon}" TextColor="{StaticResource Success}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Você assistiu todas as aulas" Style="{StaticResource TitleSm}" />
                                <Label Text="Pode rever qualquer aula do curso." Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="{Binding BotaoTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding IniciarAulasCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Andamento do curso -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding TemCurso}">
                <Label Text="Seu progresso" Style="{StaticResource TitleSm}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding AulasTexto}" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ProgressoCurso, StringFormat='{0:0}%'}"
                                   Style="{StaticResource TitleMd}" TextColor="{StaticResource BrandPrimary}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding ProgressoCurso, Converter={StaticResource PercentToProgress}}" />
                        <Label Text="{Binding ModuloTexto}" Style="{StaticResource BodySm}" IsVisible="{Binding TemModuloTexto}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Provas pendentes (só aparece quando há alguma) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding TemProvasPendentes}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding ProvasPendentesTexto}" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Ver todas" Style="{StaticResource BodySm}" TextColor="{StaticResource BrandPrimary}"
                           FontFamily="OpenSansSemibold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirProvasCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ProvasPendentes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProvaItem">
                            <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, Path=AbrirProvasCommand, x:DataType=vm:InicioViewModel}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                                            BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                        <Label Text="&#xe862;" Style="{StaticResource Icon}" FontSize="20" TextColor="{StaticResource Warning}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="15"
                                               TextColor="{StaticResource OnSurface}" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding MateriaNome}" Style="{StaticResource BodySm}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Prazo}" Style="{StaticResource BodySm}"
                                           VerticalOptions="Center" HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Certificado (só depois de emitido) -->
            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent"
                    IsVisible="{Binding TemCertificado}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirCertificadoCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="&#xea3f;" Style="{StaticResource Icon}" FontSize="28"
                           TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Seu certificado está disponível" Style="{StaticResource TitleSm}" />
                        <Label Text="{Binding ValidadeTexto}" Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xe5cc;" Style="{StaticResource Icon}" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Sem curso liberado -->
            <controls:EstadoVazio Icone="&#xe80c;" Titulo="Nenhum curso disponível" Texto="Assim que a coordenação liberar seu curso, ele aparecerá aqui." IsVisible="{Binding SemCurso}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
