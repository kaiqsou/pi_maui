<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.ProvaRealizarPage"
             x:DataType="vm:ProvaRealizarViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!-- Uma questão por vez: topo com cronômetro e mapa das questões; rodapé com Anterior / Próxima (na última, Enviar). -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Cabeçalho com cronômetro -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="20,16,20,12">
            <Border Style="{StaticResource BackTile}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SairCommand}" />
                </Border.GestureRecognizers>
                <Label Text="&#xe5cd;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding Title}" Style="{StaticResource TitleSm}" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Subtitulo}" Style="{StaticResource BodySm}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" IsVisible="{Binding TemTempo}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding TempoAcabando}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" />
                    </DataTrigger>
                </Border.Triggers>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="&#xe425;" Style="{StaticResource IconPrimary}" FontSize="16" />
                    <Label Text="{Binding TempoRestante}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource BrandPrimary}" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding TempoAcabando}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Mapa das questões: toque para ir direto; respondidas ficam preenchidas -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,0,20,12">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Questoes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestaoResposta">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="1.5"
                                Stroke="{StaticResource Outline}" BackgroundColor="{StaticResource SurfaceCard}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Respondida}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Atual}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaRealizarViewModel}}, Path=IrParaCommand, x:DataType=vm:ProvaRealizarViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Numero}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Respondida}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Questão atual -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="14">

                <Border Style="{StaticResource Card}" IsVisible="{Binding TemInstrucoes}"
                        BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent">
                    <Label Text="{Binding Instrucoes}" Style="{StaticResource BodySm}" TextColor="{StaticResource OnSurface}" />
                </Border>

                <Border Style="{StaticResource Card}" BindingContext="{Binding QuestaoAtual}" x:DataType="vm:QuestaoResposta">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource Pill}" VerticalOptions="Start">
                                <Label Text="{Binding Numero}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Enunciado}" Style="{StaticResource BodyMd}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="2" Text="{Binding PesoTexto}" Style="{StaticResource BodySm}" />
                        </Grid>

                        <!-- dissertativa: resposta escrita -->
                        <Border Style="{StaticResource CampoTexto}" IsVisible="{Binding IsDissertativa}">
                            <Editor Text="{Binding Texto}" Placeholder="Escreva sua resposta" AutoSize="TextChanges"
                                    MinimumHeightRequest="160" />
                        </Border>

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alternativas}" IsVisible="{Binding IsAlternativas}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlternativaOpcao">
                                    <Border Style="{StaticResource Painel}" Padding="12,10">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Selecionada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaRealizarViewModel}}, Path=SelecionarCommand, x:DataType=vm:ProvaRealizarViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13"
                                                    Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceCard}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Selecionada}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Letra}" FontSize="12" FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource OnSurfaceVariant}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Selecionada}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource BrandOnPrimaryContainer}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource BodyMd}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Anterior / Próxima (na última questão, Enviar prova) -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="20,12,20,16">
                <Button Grid.Column="0" Text="Anterior" Style="{StaticResource GhostButton}" Command="{Binding AnteriorCommand}"
                        IsEnabled="{Binding PodeAnterior}" />
                <Label Grid.Column="1" Text="{Binding IndicadorQuestao}" Style="{StaticResource BodySm}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="{Binding BotaoProximaTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding ProximaCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Grid>

    </Grid>

</views:BasePage>
