<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:models="clr-namespace:European.Models"
             x:Class="European.Views.AulaDetalhePage"
             x:DataType="vm:AulaViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
            </Grid>

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="220">
                <WebView x:Name="VideoPlayer" Source="{Binding VideoSource}" HeightRequest="220" />
            </Border>

            <Label Text="Vídeo de demonstração" Style="{StaticResource BodySm}" TextColor="{StaticResource OnSurfaceVariant}" />

            <Label Text="{Binding Aula.Titulo}" Style="{StaticResource TitleMd}" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="&#xea19;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                <Label Grid.Column="1" Text="{Binding MateriaNome}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding DuracaoFormatada}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding Aula.Descricao}" Style="{StaticResource BodyMd}" />

            <VerticalStackLayout Spacing="4">
                <ProgressBar Progress="{Binding PercentualAssistido, Converter={StaticResource PercentToProgress}}" />
                <Label Text="{Binding ProgressoTexto}" Style="{StaticResource BodySm}" />
            </VerticalStackLayout>

            <Button Text="{Binding ConcluirTexto}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConcluirCommand}" IsEnabled="{Binding PodeConcluir}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Aulas" Command="{Binding SelecionarAbaCommand}" CommandParameter="aulas"
                        Style="{StaticResource GhostButton}" HeightRequest="42">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding MostrarAulas}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Materiais" Command="{Binding SelecionarAbaCommand}" CommandParameter="materiais"
                        Style="{StaticResource GhostButton}" HeightRequest="42">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding MostrarMateriais}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarAulas}"
                                 BindableLayout.ItemsSource="{Binding AulasDoModulo}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AulaItem">
                        <Border Style="{StaticResource Card}" Padding="14" BackgroundColor="{StaticResource SurfaceCard}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelecionada}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AulaViewModel}}, Path=AbrirAulaCommand, x:DataType=vm:AulaViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="&#xe1c4;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding MateriaNome}" Style="{StaticResource BodySm}" TextColor="{StaticResource BrandPrimary}" />
                                    <Label Text="{Binding Aula.Titulo}" Style="{StaticResource TitleSm}" />
                                    <Label Text="{Binding Duracao}" Style="{StaticResource BodySm}" IsVisible="{Binding Liberada}" />
                                    <Label Text="Bloqueada" Style="{StaticResource BodySm}" TextColor="{StaticResource Danger}"
                                           IsVisible="{Binding Bloqueada}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="&#xe86c;" Style="{StaticResource Icon}" FontSize="18"
                                       TextColor="{StaticResource Success}" VerticalOptions="Center"
                                       IsVisible="{Binding Concluida}" />
                                <Label Grid.Column="2" Text="&#xe897;" Style="{StaticResource Icon}" FontSize="18"
                                       TextColor="{StaticResource Danger}" VerticalOptions="Center"
                                       IsVisible="{Binding Bloqueada}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarMateriais}"
                                 BindableLayout.ItemsSource="{Binding Materiais}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MaterialComplementar">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AulaViewModel}}, Path=AbrirMaterialCommand, x:DataType=vm:AulaViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="&#xe873;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TitleSm}" />
                                    <Label Text="{Binding Tipo}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="&#xf090;" Style="{StaticResource Icon}" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
