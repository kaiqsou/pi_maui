<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.ProvaResultadosPage"
             x:DataType="vm:ProvaResultadosViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho, dados da prova e resumo fixos; só a lista de entregas rola -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" Padding="0,16,0,0">

        <controls:Cabecalho Titulo="{Binding Title}" Subtitulo="Prova" Margin="20,0">
            <Button Text="Editar" Style="{StaticResource SoftButton}" VerticalOptions="Center"
                    Command="{Binding EditarCommand}" IsVisible="{Binding PodeEditar}" />
        </controls:Cabecalho>

        <!-- Dados essenciais -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0" Padding="14">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding MateriaTexto}" Style="{StaticResource TitleSm}" FontSize="15" VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalOptions="Start" BackgroundColor="{DynamicResource Outline}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Publicada}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessSoft}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding StatusTexto}" FontFamily="TextoNegrito" FontSize="11" TextColor="{DynamicResource OnSurface}" />
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="&#xe7ef;" Style="{StaticResource Icon}" FontSize="16" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <Label Grid.Column="1" Text="{Binding TurmaTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="&#xe873;" Style="{StaticResource Icon}" FontSize="16" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <Label Grid.Column="1" Text="{Binding RegrasTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="&#xe8b5;" Style="{StaticResource Icon}" FontSize="16" TextColor="{DynamicResource OnSurfaceVariant}" />
                    <Label Grid.Column="1" Text="{Binding PrazoTexto}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="2" Text="Entregas dos alunos" Style="{StaticResource TitleSm}" Margin="20,4,20,0" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,0" Padding="14" BackgroundColor="{DynamicResource BrandContainerSoft}" Stroke="Transparent">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="&#xe8f5;" Style="{StaticResource IconPrimary}" FontSize="20" VerticalOptions="Start" IsVisible="{Binding ModoCego}" />
                <Label Grid.Column="1" Text="{Binding Resumo}" Style="{StaticResource BodySm}" TextColor="{DynamicResource OnSurface}" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Resultados}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultadoAlunoItem">
                    <ContentView Padding="20,0,20,12">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvaResultadosViewModel}}, Path=AbrirCommand, x:DataType=vm:ProvaResultadosViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                                    <Label Text="{Binding Iniciais}" FontFamily="TextoNegrito" TextColor="{DynamicResource BrandPrimary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" BackgroundColor="{DynamicResource WarningSoft}">
                                    <Border.Triggers>
                                        <MultiTrigger TargetType="Border">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding Corrigida}" Value="True" />
                                                <BindingCondition Binding="{Binding Aprovado}" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource DangerSoft}" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Aprovado}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessSoft}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding NotaTexto}" FontFamily="TextoNegrito" FontSize="13" TextColor="{DynamicResource OnSurface}" />
                                </Border>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</views:BasePage>
