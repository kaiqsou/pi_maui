<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.ProvaResultadosPage"
             x:DataType="vm:ProvaResultadosViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="16">

        <controls:Cabecalho Titulo="Notas da prova" Subtitulo="{Binding Title}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Resultados}" SelectionMode="None">
            <CollectionView.Header>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" BackgroundColor="{StaticResource BrandContainerSoft}" Stroke="Transparent">
                    <Label Text="{Binding Resumo}" Style="{StaticResource BodyMd}" />
                </Border>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultadoAlunoItem">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                                <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" TextColor="{StaticResource BrandPrimary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center" BackgroundColor="{StaticResource DangerSoft}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Aprovado}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Nota, StringFormat='{0:0.0}'}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource OnSurface}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
