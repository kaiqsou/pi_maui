<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:European.Controls"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.CertificadoDetalhePage"
             x:DataType="vm:CertificadoDetalheViewModel"
             Title="Certificado"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <controls:Cabecalho Titulo="Certificado" />

            <Border Style="{StaticResource Card}" Padding="24">
                <VerticalStackLayout Spacing="14">
                    <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                            BackgroundColor="{DynamicResource WarningSoft}" Stroke="Transparent"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Label Text="&#xea3f;" Style="{StaticResource Icon}" FontSize="38"
                               TextColor="{DynamicResource Warning}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="EUROPEAN · CERTIFICADO" Style="{StaticResource BodySm}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="1" Color="{DynamicResource Outline}" />
                    <Label Text="Certificamos que" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Certificado.AlunoNome}" Style="{StaticResource TitleSm}" HorizontalTextAlignment="Center" />
                    <Label Text="concluiu o curso de" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Certificado.CursoNome}" Style="{StaticResource BodyMd}" HorizontalTextAlignment="Center" TextColor="{DynamicResource BrandPrimary}" />
                    <Label Text="{Binding Certificado.PeriodoTexto, StringFormat='Período: {0}'}" Style="{StaticResource BodySm}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding TemPeriodo}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Carga horária" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Certificado.CargaHorariaHoras, StringFormat='{0:N0} horas'}" Style="{StaticResource TitleSm}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Emissão" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding EmissaoTexto}" Style="{StaticResource TitleSm}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Código" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Certificado.CodigoVerificacao}" Style="{StaticResource TitleSm}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Baixar PDF" Style="{StaticResource PrimaryButton}" Command="{Binding BaixarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
