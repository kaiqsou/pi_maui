<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.SalaEditPage"
             x:DataType="vm:SalaEditViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho fixo, conteúdo rola, "Salvar sala" fixo embaixo -->
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:Cabecalho Titulo="{Binding Title}" Margin="20,16,20,12" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="16">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nome da sala" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding Nome}" Placeholder="Ex.: Turma A — 2026" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Descrição (opcional)" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding Descricao}" Placeholder="Ex.: Alunos do período noturno" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Curso" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Picker ItemsSource="{Binding Cursos}" SelectedItem="{Binding CursoSelecionado}"
                                        ItemDisplayBinding="{Binding Texto, x:DataType=vm:CursoOpcao}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Alunos" Style="{StaticResource TitleSm}" />
                            <Label Text="{Binding ResumoAlunos}" Style="{StaticResource BodySm}" />
                        </VerticalStackLayout>

                        <!-- busca: só alunos matriculados nos cursos que o professor leciona -->
                        <Border Style="{StaticResource Campo}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="&#xe8b6;" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Entry Grid.Column="1" Text="{Binding Busca}" Placeholder="Buscar aluno por nome ou e-mail" Keyboard="Email"
                                       ReturnCommand="{Binding AdicionarAlunoCommand}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding TemSugestoes}" BindableLayout.ItemsSource="{Binding Sugestoes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PessoaItem">
                                    <Border Style="{StaticResource Painel}" Padding="10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SalaEditViewModel}}, Path=AdicionarSugestaoCommand, x:DataType=vm:SalaEditViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                            <Border Style="{StaticResource IconTile}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                                <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" />
                                                <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="&#xe145;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Nenhum aluno dos seus cursos encontrado." Style="{StaticResource BodySm}" IsVisible="{Binding SemResultado}" />

                        <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                        <!-- alunos já na sala -->
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alunos}">
                            <BindableLayout.EmptyView>
                                <Label Text="Nenhum aluno na sala ainda." Style="{StaticResource Muted}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PessoaItem">
                                    <Grid ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="10">
                                        <Border Style="{StaticResource IconTile}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                            <Label Text="{Binding Iniciais}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" />
                                            <Label Text="{Binding Email}" Style="{StaticResource BodySm}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Status}" Style="{StaticResource BodySm}" VerticalOptions="Center"
                                               TextColor="{StaticResource Success}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Alerta}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Button Grid.Column="3" Text="&#xe5cd;" Style="{StaticResource IconButton}" ToolTipProperties.Text="Tirar da sala"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SalaEditViewModel}}, Path=RemoverAlunoCommand, x:DataType=vm:SalaEditViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Excluir sala" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}"
                        Command="{Binding ExcluirCommand}" IsVisible="{Binding IsEdicao}" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
            <Button Grid.Row="1" Text="Salvar sala" Style="{StaticResource PrimaryButton}" Margin="20,12,20,16"
                    Command="{Binding SalvarCommand}" IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>

</views:BasePage>
