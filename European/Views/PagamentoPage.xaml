<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.PagamentoPage"
             x:DataType="vm:PagamentoViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,28" Spacing="18">

            <VerticalStackLayout Spacing="2">
                <Label Text="Pagamento" Style="{StaticResource TitleLg}" />
                <Label Text="Conclua o pagamento para enviar sua matrícula à coordenação." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <!-- Resumo do pedido -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                            <Label Text="&#xe80c;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding CursoNome}" Style="{StaticResource TitleSm}" />
                            <Label Text="{Binding CargaTexto}" Style="{StaticResource BodySm}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Total" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding PrecoTexto}" Style="{StaticResource TitleMd}" TextColor="{StaticResource BrandPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Forma de pagamento -->
            <Label Text="Forma de pagamento" Style="{StaticResource TitleSm}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,12" StrokeShape="RoundRectangle 14">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPix}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelecionarFormaCommand}" CommandParameter="pix" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xef6b;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" />
                        <Label Text="Pix" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" TextColor="{StaticResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,12" StrokeShape="RoundRectangle 14">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsCredito}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelecionarFormaCommand}" CommandParameter="credito" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe870;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" />
                        <Label Text="Crédito" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" TextColor="{StaticResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12" StrokeShape="RoundRectangle 14">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDebito}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandContainerSoft}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelecionarFormaCommand}" CommandParameter="debito" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe850;" Style="{StaticResource IconPrimary}" HorizontalOptions="Center" />
                        <Label Text="Débito" Style="{StaticResource BodySm}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" TextColor="{StaticResource OnSurface}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Pix -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsPix}">
                <VerticalStackLayout Spacing="14">
                    <Border WidthRequest="160" HeightRequest="160" HorizontalOptions="Center"
                            BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 16">
                        <Label Text="&#xef6b;" Style="{StaticResource Icon}" FontSize="120" TextColor="{StaticResource OnSurface}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Escaneie o QR Code no app do seu banco ou use o código Pix copia e cola."
                           Style="{StaticResource BodySm}" HorizontalTextAlignment="Center" />
                    <Border Style="{StaticResource Campo}" Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding CodigoPix}" Style="{StaticResource BodySm}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="&#xe14d;" Style="{StaticResource IconPrimary}" FontSize="20">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CopiarPixCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Cartão (crédito ou débito) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsCartao}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Número do cartão" Style="{StaticResource BodySm}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry Text="{Binding NumeroCartao}" Placeholder="0000 0000 0000 0000" Keyboard="Numeric" MaxLength="23"
                                   TextColor="{StaticResource OnSurface}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome impresso no cartão" Style="{StaticResource BodySm}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry Text="{Binding NomeCartao}" Placeholder="Como está no cartão" TextTransform="Uppercase"
                                   TextColor="{StaticResource OnSurface}" />
                        </Border>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Validade" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding Validade}" Placeholder="MM/AA" MaxLength="5" TextColor="{StaticResource OnSurface}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="CVV" Style="{StaticResource BodySm}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry Text="{Binding Cvv}" Placeholder="123" Keyboard="Numeric" MaxLength="4" IsPassword="True"
                                       TextColor="{StaticResource OnSurface}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCredito}">
                        <Label Text="Parcelas" Style="{StaticResource BodySm}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker ItemsSource="{Binding Parcelas}" SelectedItem="{Binding ParcelaSelecionada}"
                                    ItemDisplayBinding="{Binding Texto, x:DataType=vm:ParcelaOpcao}" TextColor="{StaticResource OnSurface}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Mensagem}" Style="{StaticResource BodySm}" TextColor="{StaticResource Danger}" IsVisible="{Binding TemMensagem}" />

            <Button Text="{Binding BotaoTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding PagarCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource BrandPrimary}" HeightRequest="24" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center">
                <Label Text="&#xe897;" Style="{StaticResource Icon}" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                <Label Grid.Column="1" Text="Ambiente de demonstração: nenhum valor é cobrado." Style="{StaticResource BodySm}" VerticalOptions="Center" />
            </Grid>

            <Button Text="Sair" Style="{StaticResource GhostButton}" Command="{Binding SairCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
