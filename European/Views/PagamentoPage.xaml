<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.PagamentoPage"
             x:DataType="vm:PagamentoViewModel"
             Title="Finalizar compra"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" Style="{StaticResource Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Finalizar compra" Style="{StaticResource TitleMd}" VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Resumo do pedido" Style="{StaticResource TitleSm}" />
                    <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding CursoNome}" Style="{StaticResource TitleSm}" />
                        <Label Grid.Column="1" Text="{Binding Valor}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource BrandPrimary}" />
                    </Grid>
                    <Label Text="{Binding CursoDescricao}" Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="&#xe8b5;" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Grid.Column="1" Text="{Binding CargaHoraria}" Style="{StaticResource BodySm}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding CursoCategoria}" Style="{StaticResource BodySm}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding TemCorpoDocente}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Corpo docente" Style="{StaticResource TitleSm}" />
                    <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                    <VerticalStackLayout Spacing="2" IsVisible="{Binding TemCoordenador}">
                        <Label Text="Coordenação" Style="{StaticResource Muted}" />
                        <Label Text="{Binding Coordenador}" Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Professores" Style="{StaticResource Muted}" />
                        <Label Text="{Binding DocentesTexto}" Style="{StaticResource BodySm}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Forma de pagamento" Style="{StaticResource TitleSm}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BrandPrimary}"
                                StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="&#xe2a6;" Style="{StaticResource Icon}" FontSize="22" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
                                <Label Text="PIX" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource Outline}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="&#xea41;" Style="{StaticResource Icon}" FontSize="22" TextColor="{StaticResource OnSurfaceVariant}" HorizontalOptions="Center" />
                                <Label Text="Cartão" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Label Text="Ambiente de demonstração — o pagamento não será processado." Style="{StaticResource BodySm}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Confirmar pagamento" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConfirmarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>