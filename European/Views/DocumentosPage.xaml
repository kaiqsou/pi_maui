<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.DocumentosPage"
             x:DataType="vm:DocumentosViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Documentos" Style="{StaticResource TitleLg}" />
                <Label Text="Envie cada documento exigido para o mestrado, em foto ou PDF. Pode mandar mais de um arquivo por documento (ex.: frente e verso)." Style="{StaticResource Muted}" />
                <Label Text="{Binding CursoNome}" Style="{StaticResource BodySm}" FontFamily="TextoNegrito" TextColor="{DynamicResource BrandPrimary}" />
            </VerticalStackLayout>

            <!-- Devolvida pela coordenação -->
            <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource DangerSoft}" Stroke="Transparent" IsVisible="{Binding TemPendencia}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="A coordenação pediu correções" Style="{StaticResource BodySm}" TextColor="{DynamicResource Danger}" FontFamily="TextoNegrito" />
                    <Label Text="{Binding PendenciaTexto}" Style="{StaticResource BodyMd}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ResumoTexto}" Style="{StaticResource TitleSm}" />

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Itens}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentoItem">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Recusado}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nome}" Style="{StaticResource TitleSm}" FontSize="15" />
                                    <Label Text="{Binding Dica}" Style="{StaticResource BodySm}" />
                                    <Label Text="{Binding StatusTexto}" Style="{StaticResource BodySm}" FontFamily="TextoNegrito" TextColor="{DynamicResource Warning}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Enviado}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Recusado}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Observacao}" Style="{StaticResource BodySm}" IsVisible="{Binding TemObservacao}" />
                                </VerticalStackLayout>

                                <!-- arquivos enviados: miniatura da foto ou ícone de PDF, com o X para remover -->
                                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Arquivos}" IsVisible="{Binding Enviado}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ArquivoItem">
                                            <Grid WidthRequest="72" HeightRequest="72" Margin="0,0,8,8">
                                                <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{DynamicResource BrandContainerSoft}">
                                                    <Grid>
                                                        <Image Source="{Binding Caminho}" Aspect="AspectFill" IsVisible="{Binding TemMiniatura}" />
                                                        <VerticalStackLayout Spacing="0" VerticalOptions="Center" IsVisible="{Binding IsPdf}">
                                                            <Label Text="&#xe415;" Style="{StaticResource IconPrimary}" FontSize="28" HorizontalOptions="Center" />
                                                            <Label Text="PDF" Style="{StaticResource BodySm}" FontFamily="TextoNegrito" HorizontalOptions="Center" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                                <Border WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                                        BackgroundColor="{DynamicResource Danger}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-6,0"
                                                        SemanticProperties.Description="Remover arquivo">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentosViewModel}}, Path=RemoverCommand, x:DataType=vm:DocumentosViewModel}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xe5cd;" Style="{StaticResource Icon}" FontSize="16" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Button Text="Adicionar foto ou PDF" Style="{StaticResource SoftButton}" IsVisible="{Binding PodeAdicionar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentosViewModel}}, Path=AdicionarCommand, x:DataType=vm:DocumentosViewModel}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="{Binding BotaoContinuarTexto}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinuarCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Desistir da matrícula" Style="{StaticResource GhostButton}" Command="{Binding DesistirCommand}"
                    TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Danger}" IsVisible="{Binding TemPendencia}" />
            <Button Text="Sair" Style="{StaticResource GhostButton}" Command="{Binding SairCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
