<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:vm="clr-namespace:European.ViewModels"
             xmlns:controls="clr-namespace:European.Controls"
             x:Class="European.Views.MateriaEditPage"
             x:DataType="vm:MateriaEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!-- Cabeçalho fixo; só o conteúdo abaixo dele rola -->
    <Grid RowDefinitions="Auto,*">
        <controls:Cabecalho Titulo="{Binding Title}" Subtitulo="{Binding ModuloTitulo}" Margin="20,16,20,12" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,4,20,28" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Label Text="Nome" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource Campo}">
                    <Entry Text="{Binding Nome}" Placeholder="Nome da matéria" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição (opcional)" Style="{StaticResource BodySm}" />
                <Border Style="{StaticResource CampoTexto}">
                    <Editor Text="{Binding Descricao}" Placeholder="Ementa resumida" HeightRequest="90" TextColor="{StaticResource OnSurface}" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Salvar" Style="{StaticResource PrimaryButton}" Command="{Binding SalvarCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>

</views:BasePage>
