<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:European.Views"
             xmlns:controls="clr-namespace:European.Controls"
             xmlns:vm="clr-namespace:European.ViewModels"
             x:Class="European.Views.SalaDetalhePage"
             x:DataType="vm:SalaDetalheViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <controls:Cabecalho Titulo="{Binding Title}" Subtitulo="Turma">
                <Button Text="Editar" Style="{StaticResource SoftButton}" VerticalOptions="Center" Command="{Binding EditarCommand}" />
            </controls:Cabecalho>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Dados da turma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xe80c;" Style="{StaticResource IconPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding CursoNome}" Style="{StaticResource TitleSm}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Sala.Descricao}" Style="{StaticResource BodyMd}" IsVisible="{Binding TemDescricao}" />
                    <Label Text="{Binding ResumoTexto}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Alunos -->
            <Label Text="Alunos" Style="{StaticResource TitleSm}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alunos}">
                <BindableLayout.EmptyView>
                    <controls:EstadoVazio Icone="&#xe7fb;" Titulo="Nenhum aluno na turma" Texto="Use Editar para adicionar alunos dos seus cursos." Padding="0,10" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PessoaItem">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource BrandPrimary}">
                                    <Label Text="{Binding Iniciais}" FontFamily="TextoNegrito" TextColor="{DynamicResource BrandOnPrimaryContainer}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" Style="{StaticResource BodyMd}" FontFamily="TextoNegrito" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Provas direcionadas à turma -->
            <Label Text="Provas da turma" Style="{StaticResource TitleSm}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Provas}">
                <BindableLayout.EmptyView>
                    <Label Text="Nenhuma prova direcionada a esta turma." Style="{StaticResource Muted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProvaResumo">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SalaDetalheViewModel}}, Path=AbrirProvaCommand, x:DataType=vm:SalaDetalheViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource BodyMd}" FontFamily="TextoNegrito" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource BodySm}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalOptions="Center">
                                    <Label Text="{Binding Status}" FontSize="12" FontFamily="TextoNegrito" TextColor="{DynamicResource BrandPrimary}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
