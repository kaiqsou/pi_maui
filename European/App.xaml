<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:European"
             xmlns:conv="clr-namespace:European.Converters"
             x:Class="European.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:CountToBoolConverter x:Key="CountToBool" />
            <conv:PercentageTextConverter x:Key="PercentageText" />
            <conv:PercentToProgressConverter x:Key="PercentToProgress" />
            <conv:StatusMatriculaToColorConverter x:Key="StatusMatriculaToColor" />
            <conv:RoleToVisibilityConverter x:Key="RoleToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
