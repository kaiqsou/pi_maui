<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Cores do app (paleta única, só tema claro). Use sempre estas chaves em vez de cores fixas. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Marca -->
    <Color x:Key="BrandPrimary">#3525CD</Color>
    <Color x:Key="BrandOnPrimaryContainer">#FFFFFF</Color>
    <Color x:Key="BrandContainerSoft">#E9E6FF</Color>

    <!-- Superfícies e texto -->
    <Color x:Key="Surface">#FAF8FF</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="OnSurface">#1A1A2E</Color>
    <Color x:Key="OnSurfaceVariant">#64647A</Color>
    <Color x:Key="Outline">#E4E2EE</Color>

    <!-- Estados -->
    <Color x:Key="Success">#12B76A</Color>
    <Color x:Key="SuccessSoft">#E6F7EF</Color>
    <Color x:Key="Warning">#F79009</Color>
    <Color x:Key="WarningSoft">#FEF3E2</Color>
    <Color x:Key="Danger">#F04438</Color>
    <Color x:Key="DangerSoft">#FDECEA</Color>

    <!-- Campos: texto de exemplo e controles desabilitados -->
    <Color x:Key="Placeholder">#C8C8C8</Color>
    <Color x:Key="Desabilitado">#ACACAC</Color>

    <SolidColorBrush x:Key="ShadowBrush" Color="#1A1A2E" />
</ResourceDictionary>
