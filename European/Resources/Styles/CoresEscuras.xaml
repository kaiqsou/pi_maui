<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Tema escuro: a identidade do site do European & Icon Institute (fundo escuro e dourado).
    Os valores vêm das variáveis CSS de institutoeuropean.com. As MESMAS chaves existem em CoresClaras.xaml:
    use sempre {DynamicResource Chave} para a tela acompanhar a troca de tema (TemaService).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="European.Resources.Styles.CoresEscuras">

    <!-- Marca: dourado (botões, ícones e destaques) e o texto escuro que vai sobre ele -->
    <Color x:Key="BrandPrimary">#E7B643</Color>
    <Color x:Key="BrandPrimaryLight">#FFE387</Color>
    <Color x:Key="BrandOnPrimaryContainer">#121315</Color>
    <Color x:Key="BrandContainerSoft">#2E2A1E</Color>

    <!-- Superfícies e texto -->
    <Color x:Key="Surface">#121315</Color>
    <Color x:Key="SurfaceCard">#1A1C20</Color>
    <Color x:Key="OnSurface">#F5F5F4</Color>
    <Color x:Key="OnSurfaceVariant">#8B919D</Color>
    <Color x:Key="Outline">#2D3138</Color>

    <!-- Estados -->
    <Color x:Key="Success">#47B881</Color>
    <Color x:Key="SuccessSoft">#1B2E25</Color>
    <Color x:Key="Warning">#F0B54A</Color>
    <Color x:Key="WarningSoft">#33291A</Color>
    <Color x:Key="Danger">#E35D6A</Color>
    <Color x:Key="DangerSoft">#3A2024</Color>

    <!-- Campos: texto de exemplo e controles desabilitados -->
    <Color x:Key="Placeholder">#5E636D</Color>
    <Color x:Key="Desabilitado">#4A4E57</Color>

    <SolidColorBrush x:Key="ShadowBrush" Color="#000000" />

    <!-- Linha dourada curta abaixo dos títulos, como no site -->
    <LinearGradientBrush x:Key="GradienteDourado" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#996D1C" Offset="0" />
        <GradientStop Color="#FFE387" Offset="0.5" />
        <GradientStop Color="#996D1C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
