<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EuropeanMaui.Controls.SectionTitleView"
             BackgroundColor="Transparent">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Label Grid.Column="0" Text="{Binding Title}"
               FontSize="18" FontFamily="OpenSansBold"
               TextColor="{DynamicResource Text}" />
        <Label Grid.Column="1" Text="{Binding ActionLabel}"
               FontSize="12" FontFamily="OpenSansSemibold"
               TextColor="{DynamicResource PrimaryDark}"
               IsVisible="{Binding HasAction}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnActionTapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentView>