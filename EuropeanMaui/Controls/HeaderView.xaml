<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EuropeanMaui.Controls.HeaderView"
             BackgroundColor="Transparent">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <VerticalStackLayout Grid.Column="0" Spacing="4">
            <Label Text="{Binding Title}" FontSize="24" FontFamily="OpenSansBold"
                   TextColor="{DynamicResource Text}" LineBreakMode="TailTruncation" />
            <Label Text="{Binding Subtitle}" FontSize="15" FontFamily="OpenSansRegular"
                   TextColor="{DynamicResource TextMuted}" IsVisible="{Binding HasSubtitle}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>