<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Popula o MongoDB com dados de demonstração (cursos, aulas, provas, turmas, usuários...).
		Uso (na pasta pi_maui): dotnet run, com a opção project apontando para Seed
		ATENÇÃO: apaga o banco "european" antes de gravar.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>European.Seed</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="MongoDB.Driver" Version="3.13.0" />
	</ItemGroup>

	<!--
		Reaproveita os modelos do app, para gravar exatamente o formato que a API devolve para ele.
		O app não acessa mais o MongoDB (fala com a API em European-API); só o Seed continua gravando direto
		no banco, por isso o MongoContext e o ColecaoExtensions agora ficam aqui (pasta Data).
	-->
	<ItemGroup>
		<Compile Include="..\European\Models\*.cs" Link="App\Models\%(Filename).cs" />
		<Compile Include="..\European\Enums\*.cs" Link="App\Enums\%(Filename).cs" />
		<Compile Include="..\European\Data\Ids.cs" Link="App\Data\Ids.cs" />
		<Compile Include="..\European\Data\CursosIniciais.cs" Link="App\Data\CursosIniciais.cs" />
		<Compile Include="..\European\Services\SenhaService.cs" Link="App\Services\SenhaService.cs" />
	</ItemGroup>

</Project>
